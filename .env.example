# Environment configuration for Hospital Bed Management System

# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
# Leave empty to use fallback deterministic severity scoring
GEMINI_API_KEY=

# Database Configuration
DB_PATH=./data/hospital.db

# LangGraph Configuration
# Set to false if LangGraph is installed to use graph-based orchestration
# Default: true (use pure Python fallback orchestrator)
LANGGRAPH_FALLBACK=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
